# Access key and secret key for the S3-compatible object storage (RustFS)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Postgres connection config
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# JWT signing config
# Two different random strings, e.g. `openssl rand -hex 32`
SESSION_SECRET_KEY=
REFRESH_SECRET_KEY=
JWT_ALGORITHM=HS256
SESSION_TTL_MINUTES=5
REFRESH_TTL_DAYS=7

# First ORG user, created on start if none exists. Pending: the password must be changed on first login
DEFAULT_ORG_EMAIL=admin
DEFAULT_ORG_PASSWORD=admin

# Storage (optional, defaults shown). The YAML policy can override per role.
S3_PUBLIC_ENDPOINT=http://localhost:5003
STORAGE_MAX_IMAGE_BYTES=5242880
STORAGE_MAX_FILE_BYTES=10485760
STORAGE_UPLOAD_PER_MINUTE=10
STORAGE_UPLOAD_PER_DAY=200
STORAGE_DOWNLOAD_PER_MINUTE=300

# Push notifications (optional): service-account key from Firebase, placed in ./secrets/. Unset = no pushes
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase.json

# Set either to true to load sample data (all accounts use password "password") when the database is empty
DEBUG=false
TEST=false

# Grafana (http://<host>:5006). Required: compose refuses to start without a password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# How much metrics history Prometheus keeps; the oldest data goes first when either limit is hit.
# Defaults keep everything (100y = forever, 0 = no size limit). E.g. 30d and 2GB; the instance has 20 GB of disk
PROMETHEUS_RETENTION_TIME=100y
PROMETHEUS_RETENTION_SIZE=0
