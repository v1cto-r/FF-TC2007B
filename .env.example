####### LAS LLAVES DEBEN DE SER DISTINTAS A PESAR DE SER EL MISMO COMANDO #######
###################### SE DEBEN GENERAR VARIAS LLAVES ###########################

# Access key and secret key for the S3-compatible object storage (RustFS)
S3_ACCESS_KEY= # generar con `openssl rand -hex 12`
S3_SECRET_KEY= # generar con `openssl rand -hex 32`

# Postgres connection config
POSTGRES_USER= # generar con `openssl rand -hex 12`
POSTGRES_PASSWORD= # generar con `openssl rand -hex 32`
POSTGRES_DB= # generar con `openssl rand -hex 12`

# Auth
SESSION_SECRET_KEY= # generar con `openssl rand -hex 32`
REFRESH_SECRET_KEY= # generar con `openssl rand -hex 32`
JWT_ALGORITHM=HS256
SESSION_TTL_MINUTES=5
REFRESH_TTL_DAYS=7

# Usuario de ORG por defecto, se genera a la hora de levantar el servidor
DEFAULT_ORG_EMAIL= # seleccionar un usuario ó correo (real o no) para acceder como el usuario de orgaización
DEFAULT_ORG_PASSWORD= # Una contraseña segura para el usuario de organización

S3_PUBLIC_ENDPOINT=https://s3.sonrisas.com # CAMBIAR por el dominio en donde se puede acceder el s3. Configurado unico al subdominio
STORAGE_MAX_IMAGE_BYTES=5242880
STORAGE_MAX_FILE_BYTES=10485760
STORAGE_UPLOAD_PER_MINUTE=10
STORAGE_UPLOAD_PER_DAY=200
STORAGE_DOWNLOAD_PER_MINUTE=300

# Notificaciones por parte de firebase, guardar en ./secrets, si no existe no se mandan notificaciones
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase.json

# Set either to true to load sample data (all accounts use password "password") when the database is empty
DEBUG=false
TEST=false

# Grafana (http://<host>:5006). Required: compose refuses to start without a password
GRAFANA_ADMIN_USER=sonrisas # Cambiar a un usuario más seguro
GRAFANA_ADMIN_PASSWORD= # Contraseña segura

# Rango de tiempo por el cual prometheus mantiene datos, cuando se alcanza el limite, se sobreescribe
# Por defecto 100y es para siempre y 0 es no limites
PROMETHEUS_RETENTION_TIME=100y
PROMETHEUS_RETENTION_SIZE=0
